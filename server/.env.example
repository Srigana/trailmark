# HTTP port for the API
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgres://analytics:analytics@localhost:5432/analytics

# Comma separated list of keys accepted by the ingest endpoint
WRITE_KEYS=dev_write_key

# Origins allowed to call the API from a browser. Shoebox proxies /collect through its own
# Next.js server, so the tracker does not need CORS; this is for the dashboard in development.
CORS_ORIGINS=http://localhost:5173

# Bearer token required by the dashboard API. Leave empty only for local development.
DASHBOARD_TOKEN=

# Number of proxies between the visitor and this server, so rate limits apply per visitor IP.
# Shoebox forwards /collect through Vercel and the host adds its own proxy. Check what
# req.ip resolves to after deploying (see README) and adjust.
TRUST_PROXY=1

# Ingest requests allowed per minute from one IP
INGEST_RATE_LIMIT_PER_MINUTE=1200

# Shoebox's own hostnames. A referrer from one of these counts as Direct, not as a referral.
SITE_HOSTS=shoebox-taupe.vercel.app,localhost

# Events older than this are rejected at ingest time, in hours
MAX_EVENT_AGE_HOURS=72

# Allowed client clock skew for future timestamps, in seconds
MAX_FUTURE_SKEW_SECONDS=300

# BigQuery export (optional). Leave BIGQUERY_PROJECT_ID empty to disable.
# Authentication uses Application Default Credentials (GOOGLE_APPLICATION_CREDENTIALS or gcloud auth).
BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET=trailmark
BIGQUERY_TABLE=events
BIGQUERY_LOCATION=US
BIGQUERY_BATCH_SIZE=1000
BIGQUERY_SYNC_INTERVAL_SECONDS=60

# Which engine runs the analysis queries: bigquery (default when BIGQUERY_PROJECT_ID is set) or postgres.
ANALYSIS_ENGINE=

# Google Analytics 4 property ID (numbers only) for the comparison page. Optional.
# The service account needs Viewer access on the GA4 property.
GA_PROPERTY_ID=
